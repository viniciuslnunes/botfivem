# Copie para .env e preencha. Nunca faça commit do .env.

# Discord Developer Portal → sua aplicação → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → sua aplicação → General Information → Application ID
CLIENT_ID=

# Railway → serviço Postgres do bot → Variables → DATABASE_URL (use a URL pública para rodar fora do Railway)
DATABASE_URL=
