# Copie para .env e preencha. Nunca faça commit do .env.

# ── Obrigatórias ────────────────────────────────────────────────────────────
# Discord Developer Portal → sua aplicação → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → sua aplicação → General Information → Application ID
CLIENT_ID=

# Postgres DESTA torcida (um banco por torcida)
DATABASE_URL=

# ── Qual torcida esta instância atende ──────────────────────────────────────
# Nome da pasta do tenant (default: gavioes). Cada instância = um tenant + um token + um Postgres.
TENANT=gavioes
# Opcional: pasta ABSOLUTA com os tenants, fora do repositório (produto vendido a várias torcidas).
# TENANTS_DIR=/tenants

# ── Banco ───────────────────────────────────────────────────────────────────
# verify | no-verify (default, histórico: TLS sem validar o certificado) | off
# Para produção: DATABASE_SSL=verify (e DATABASE_CA com o PEM ou o caminho do arquivo, se o provedor usa CA própria)
# DATABASE_SSL=verify
# DATABASE_CA=
# DATABASE_POOL_MAX=10

# ── Operação ────────────────────────────────────────────────────────────────
# texto (default) | json (uma linha JSON por log, com tenant e módulo)
# LOG_FORMATO=json
# Liga GET /health (200 ok / 503 degradado). Mantenha em rede interna.
# HEALTH_PORT=8080
# HEALTH_HOST=0.0.0.0
